# ===== iKeePay (paiements: dépôts + retraits) =====
# Base de l'API iKeePay
IKEEPAY_BASE_URL=https://api.ikeepay.com
# Identifiants marchand (dashboard iKeePay)
IKEEPAY_API_KEY=your_ikeepay_api_key
IKEEPAY_SECRET_KEY=your_ikeepay_secret_key
IKEEPAY_SITE_NAME=DigitalMarket
# sandbox | live
IKEEPAY_ENV=sandbox
# Chemins des endpoints (valeurs par défaut — à confirmer dans le dashboard iKeePay)
IKEEPAY_COLLECT_PATH=/api/v1/payment/collect
IKEEPAY_STATUS_PATH=/api/v1/payment/status
IKEEPAY_PAYOUT_PATH=/api/v1/payout
# URLs de callback (adapter aux domaines de prod)
IKEEPAY_NOTIFY_URL=https://your-api-domain.onrender.com/api/payments/ikeepay/webhook
IKEEPAY_RETURN_URL=https://your-frontend-domain.vercel.app/payment/success
IKEEPAY_CANCEL_URL=https://your-frontend-domain.vercel.app/payment/cancel
